async def handle_document(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if user_id not in ADMINS:
        return

    if admin_states.get(user_id) != "admin_add_stock_file":
        return

    document = update.message.document
    file_name = document.file_name or ""
    if not file_name.lower().endswith(".xlsx"):
        await update.message.reply_text("❌ একটি সঠিক **.xlsx** ফাইল আপলোড করুন।", parse_mode="Markdown")
        return

    target_data = admin_temp_data.get(user_id)
    if not target_data:
        await update.message.reply_text("❌ কিছু একটা সমস্যা হয়েছে। অনুগ্রহ করে 📦 Add Stock থেকে আবার শুরু করুন。", reply_markup=admin_menu_keyboard())
        admin_states.pop(user_id, None)
        return

    cat = target_data["cat"]
    srv = target_data["srv"]
    short_cat = category_short_name(cat)

    try:
        file_obj = await document.get_file()
        file_bytes = await file_obj.download_as_bytearray()
        wb = load_workbook(filename=BytesIO(bytes(file_bytes)), data_only=True)
        ws = wb.active
    except Exception as e:
        await update.message.reply_text(f"❌ এক্সেল ফাইলটি পড়তে ব্যর্থ হয়েছে: {e}")
        return

    added = 0
    for row in ws.iter_rows(min_row=1, values_only=True):
        if not row:
            continue

        if short_cat == "VPN":
            email = row[0] if len(row) > 0 else None
            password = row[1] if len(row) > 1 else None
            email_str = format_cell_value(email)
            if email_str == "":
                continue
            line = f"{email_str},{format_cell_value(password)}"

        elif short_cat == "Proxy":
            server = row[0] if len(row) > 0 else None
            port = row[1] if len(row) > 1 else None
            proxy_user = row[2] if len(row) > 2 else None
            proxy_pass = row[3] if len(row) > 3 else None
            server_str = format_cell_value(server)
            if server_str == "":
                continue
            line = ",".join([
                server_str,
                format_cell_value(port),
                format_cell_value(proxy_user),
                format_cell_value(proxy_pass),
            ])

        else:
            email = row[0] if len(row) > 0 else None
            email_str = format_cell_value(email)
            if email_str == "":
                continue
            line = email_str

        products[cat]["services"][srv]["stock"].append(line)
        added += 1

    total_stock = len(products[cat]["services"][srv]["stock"])
    await update.message.reply_text(
        f"✅ স্টক সফলভাবে আপলোড করা হয়েছে! **{added}** টি আইটেম যোগ হয়েছে。\n**{srv}** এর মোট স্টক: {total_stock}",
        reply_markup=admin_menu_keyboard(),
        parse_mode="Markdown",
    )

    admin_states.pop(user_id, None)
    admin_temp_data.pop(user_id, None)

