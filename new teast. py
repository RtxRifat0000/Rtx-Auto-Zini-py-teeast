# --- Helpers ---
def category_short_name(real_cat):
    if "VPN" in real_cat:
        return "VPN"
    if "Proxy" in real_cat:
        return "Proxy"
    return "Trusted Mail"

def build_delivery_text(cat, srv, date_str, amount, total_price, body_text):
    lines = [
        cat,
        srv,
        f"📅 তারিখ: {date_str}",
        f"🔢 পরিমাণ: {amount}",
        f"💰 মোট মূল্য: {total_price:.2f} টাকা",
        "",
        body_text,
    ]
    return "\n".join(lines)

def format_cell_value(value):
    if value is None:
        return ""
    if isinstance(value, float):
        if value.is_integer():
            return str(int(value))
        return str(value)
    return str(value).strip()

def escape_markdown_v1(text):
    if text is None:
        return ""
    text = str(text)
    for ch in ("_", "*", "`", "["):
        text = text.replace(ch, f"\\{ch}")
    return text

async def send_group_message(bot, chat_id, text, reply_markup=None):
    try:
        return await bot.send_message(chat_id=chat_id, text=text, reply_markup=reply_markup, parse_mode="Markdown")
    except Exception as e:
        logger.error(f"Markdown send to {chat_id} failed, retrying as plain text: {e}")
        try:
            return await bot.send_message(chat_id=chat_id, text=text, reply_markup=reply_markup)
        except Exception as e2:
            logger.error(f"Plain-text send to {chat_id} also failed: {e2}")
            return None

async def check_membership(bot, user_id):
    try:
        member = await bot.get_chat_member(chat_id=CHANNEL_USERNAME, user_id=user_id)
        return member.status in ("member", "administrator", "creator")
    except Exception as e:
        logger.error(f"Membership check failed for user {user_id}: {e}")
        return False

# --- Sales Report Helpers ---
def record_sale(cat, srv, amount, total_price):
    short_cat = category_short_name(cat)
    cat_data = daily_sales.setdefault(short_cat, {"amount": 0, "total_price": 0.0, "services": {}})
    cat_data["amount"] += amount
    cat_data["total_price"] += total_price
    srv_data = cat_data["services"].setdefault(srv, {"amount": 0, "total_price": 0.0})
    srv_data["amount"] += amount
    srv_data["total_price"] += total_price

def build_sales_report_text(title="📊 **Sales Report**"):
    lines = [title, ""]
    order = ["VPN", "Proxy", "Trusted Mail"]
    grand_total_pieces = 0
    grand_total_price = 0.0
    any_sales = False

    for short_cat in order:
        cat_data = daily_sales.get(short_cat, {"amount": 0, "total_price": 0.0, "services": {}})
        if cat_data["amount"] > 0:
            any_sales = True
        grand_total_pieces += cat_data["amount"]
        grand_total_price += cat_data["total_price"]

        lines.append(f"**{short_cat}**")
        if cat_data["services"]:
            idx = 1
            for srv_name, sdata in cat_data["services"].items():
                lines.append(f"{idx}. {srv_name} - Total sell: {sdata['amount']} - Total Price: {sdata['total_price']:.2f} Tk")
                idx += 1
        else:
            lines.append("কোনো সেল হয়নি")
        lines.append("")

    lines.append(f"🧾 **সর্বমোট বিক্রি:** {grand_total_pieces} পিস")
    lines.append(f"💰 **সর্বমোট আয়:** {grand_total_price:.2f} টাকা")

    if not any_sales:
        lines.insert(2, "আজ এখনো কোনো সেল হয়নি।\n")

    return "\n".join(lines).strip()

def reset_daily_sales():
    daily_sales.clear()

async def send_midnight_sales_report(context: ContextTypes.DEFAULT_TYPE):
    date_str = datetime.datetime.now().strftime("%d-%m-%Y")
    report_text = build_sales_report_text(title=f"📊 **Sales Report ({date_str})**")
    await send_group_message(context.bot, ADMIN_GROUP_ID, report_text)
    reset_daily_sales()

